# Xbox Stratus v1
# Source code lineage: https://github.com/evanjeffrey1212-eng/stratus-api

# Optional primary deployment of the vendored Stratus backend.
STRATUS_PRIMARY_API_BASE=
STRATUS_PRIMARY_API_KEY=

# Render fallback is built in as:
# https://stratus-api-2.onrender.com
STRATUS_RENDER_API_KEY=

# Shared Stratus credential.
STRATUS_API_KEY=

# Existing deployments may already store the same Stratus key under this
# server-side name. Xbox accepts it as a credential alias only.
EMBER_CLOUD_API_KEY=

# Optional alternate Stratus base.
STRATUS_API_BASE=

# Optional WebRTC TURN fallback for restrictive NAT/firewall networks.
# Keep credentials in the deployment environment, never in the public repo.
# Multiple URLs can be comma-separated, for example TURN/UDP, TURN/TCP,
# and TURN/TLS on TCP 443 from the same provider.
XBOX_TURN_URLS=
XBOX_TURN_USERNAME=
XBOX_TURN_CREDENTIAL=

# Advanced alternative: JSON array of RTCIceServer objects.
# Example shape only: [{"urls":["turn:turn.example.com:3478?transport=tcp","turns:turn.example.com:443?transport=tcp"],"username":"...","credential":"..."}]
XBOX_TURN_SERVERS_JSON=
