# Xbox Stratus v1

# Optional: deploy the vendored /stratus/api backend on a persistent host.
STRATUS_PRIMARY_API_BASE=
STRATUS_PRIMARY_API_KEY=

# Render fallback is built in as:
# https://stratus-api-2.onrender.com
# Use this only if the fallback needs a different credential.
STRATUS_RENDER_API_KEY=

# Backward-compatible shared credential. If set, it is used for both the
# configured primary and Render fallback unless a dedicated key above exists.
STRATUS_API_KEY=

# Older Synapse-compatible names are still accepted.
# EMBER_CLOUD_API_URL=
# EMBER_CLOUD_API_KEY=
