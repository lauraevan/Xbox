{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/stratus.js": {
      "maxDuration": 120
    },
    "api/nowgg.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/nowgg",
      "destination": "/api/nowgg?path="
    },
    {
      "source": "/nowgg/:path*",
      "destination": "/api/nowgg?path=:path*"
    }
  ]
}
