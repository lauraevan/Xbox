{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/stratus.js": {
      "maxDuration": 120
    },
    "api/nowgg.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/nowgg-ip/:prefix",
      "destination": "/api/nowgg?ip=:prefix&path="
    },
    {
      "source": "/nowgg-ip/:prefix/:path*",
      "destination": "/api/nowgg?ip=:prefix&path=:path*"
    },
    {
      "source": "/nowgg",
      "destination": "/api/nowgg?path="
    },
    {
      "source": "/nowgg/:path*",
      "destination": "/api/nowgg?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ]
}
